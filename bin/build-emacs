#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Configuration
###############################################################################

SRC_DIR="$HOME/ws/i/emacs/worktrees/master"
INSTALL_PREFIX="$HOME/.local"
APPS_DIR="$HOME/.local/share/applications"
PLIST_LABEL="org.gnu.Emacs"
PLIST_FILE="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"

OPERATION=""
FLAG_SYNC_BUILD=false
FLAG_PULL=false
FLAG_NO_RECONFIGURE=false
FLAG_FORCE_SIGN=false
FLAG_CLEAN_BUILD=false
FLAG_REMOVE=false
FLAG_STATUS=false

# --- Dependency lists ---

brew_build_dependencies=(
    make autoconf gnu-sed gnu-tar grep coreutils pkg-config texinfo xz m4
    sqlite gnutls librsvg little-cms2 tree-sitter webp libgccjit gcc gmp
    libjpeg zlib texlive jq
)

arch_build_dependencies=(
    texinfo gnutls librsvg libxml2 libwebp lcms2 tree-sitter libgccjit
    texlive pkgconf jansson cairo harfbuzz sqlite alsa-lib
)

###############################################################################
# Helpers
###############################################################################

log()   { printf '\n==> %s\n' "$*"; }
warn()  { printf 'Warning: %s\n' "$*" >&2; }
error() { printf 'Error: %s\n' "$*" >&2; exit 1; }

require_command() {
    command -v "$1" >/dev/null 2>&1 || error "Required command missing: $1"
}

cleanup_on_error() {
    local exit_code=$?
    if ((exit_code != 0)); then
        printf '\n❌ Task failed with exit code %d.\n' "$exit_code" >&2
        printf '   Source: %s\n' "$SRC_DIR" >&2
    fi
}
trap cleanup_on_error EXIT

usage() {
    cat <<EOF
Usage: $(basename "$0") -[S|R|Q] [sub-flags]

Pacman-style management tool for Emacs builds ($SRC_DIR)

Operations:
  -S  Sync & Build Mode
      -s  Compile and build Emacs
      -y  Fetch and sync latest upstream git commits
      -r  Skip autogen.sh and configure (fast rebuild)
      -c  Run 'make distclean' before configuring
      -f  Force deep re-signing of application bundles

  -R  Remove Mode
      -c  Remove installed Emacs, services, and unneeded dependencies

  -Q  Query Mode
      -s  Show installation and service status

Examples:
  $(basename "$0") -Ssy        # Sync upstream, configure, and build
  $(basename "$0") -Ssrf       # Fast build without reconfigure, force code sign
  $(basename "$0") -Rc         # Uninstall installed binaries and LaunchAgent/systemd service
  $(basename "$0") -Qs         # Query installation status
EOF
    exit 1
}

###############################################################################
# CLI Parsing (Pacman-style)
###############################################################################

if (($# == 0)); then
    usage
fi

while getopts ":SRQsyrcfh" opt; do
    case ${opt} in
        S) OPERATION="SYNC" ;;
        R) OPERATION="REMOVE" ;;
        Q) OPERATION="QUERY" ;;
        s)
           if [[ "$OPERATION" == "QUERY" ]]; then
               FLAG_STATUS=true
           else
               FLAG_SYNC_BUILD=true
           fi
           ;;
        y) FLAG_PULL=true ;;
        r) FLAG_NO_RECONFIGURE=true ;;
        c)
           if [[ "$OPERATION" == "REMOVE" ]]; then
               FLAG_REMOVE=true
           else
               FLAG_CLEAN_BUILD=true
           fi
           ;;
        f) FLAG_FORCE_SIGN=true ;;
        h) usage; exit 0 ;;
        \?) error "Unknown parameter: -$OPTARG" ;;
    esac
done

if [[ -z "$OPERATION" ]]; then
    error "Must specify an operation mode: -S (Sync/Build), -R (Remove), or -Q (Query)"
fi

OS="$(uname -s)"

###############################################################################
# Common Workflow
###############################################################################

validate_source_tree() {
    log "Checking source tree: $SRC_DIR"
    [[ -d "$SRC_DIR" && -f "$SRC_DIR/configure.ac" ]] ||
        error "Invalid Emacs source tree: $SRC_DIR"
}

clean_build_tree() {
    if [[ -f "$SRC_DIR/Makefile" ]]; then
        log "Cleaning build tree"
        local make_cmd="make"
        [[ "$OS" == "Darwin" ]] && make_cmd="gmake"
        "$make_cmd" -C "$SRC_DIR" distclean || true
    fi
}

sync_git_repo() {
    require_command git
    log "Syncing repository with upstream"

    git -C "$SRC_DIR" fetch --prune origin || true

    if git -C "$SRC_DIR" remote get-url upstream >/dev/null 2>&1; then
        git -C "$SRC_DIR" fetch --prune upstream
        git -C "$SRC_DIR" checkout -B master upstream/master
    fi
}

###############################################################################
# macOS: Icon Generation
###############################################################################

apply_png_icon_macos() {
    local app_dir="$1"
    local icon_dir="$(dirname "$(dirname "$SRC_DIR")")/resources/icons"
    local png_file=""

    [[ -d "$icon_dir" ]] &&
        png_file="$(find "$icon_dir" -maxdepth 1 -type f -name '*.png' | sort | head -n 1)"
    [[ -n "$png_file" && -f "$png_file" ]] || return 0

    require_command sips
    require_command iconutil

    log "Generating macOS icon from $png_file"
    local iconset="$SRC_DIR/Emacs.iconset"
    rm -rf "$iconset" && mkdir -p "$iconset"

    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" "$png_file" --out "$iconset/icon_${size}x${size}.png" >/dev/null
        local double=$((size * 2))
        sips -z "$double" "$double" "$png_file" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done

    iconutil -c icns "$iconset" -o "$app_dir/Contents/Resources/Emacs.icns"
    rm -rf "$iconset"
}

###############################################################################
# macOS: Emacs Client.app
###############################################################################

create_client_app_macos() {
    local emacsclient="$INSTALL_PREFIX/bin/emacsclient"
    local client_app="$APPS_DIR/Emacs Client.app"
    local script="$SRC_DIR/emacs-client.applescript"

    log "Creating Emacs Client.app"
    rm -rf "$client_app"

    cat > "$script" <<EOF
on open theDropped
    repeat with oneDrop in theDropped
        do shell script "$emacsclient -c -a '' -n " & quoted form of POSIX path of oneDrop
    end repeat
end open
on run
    do shell script "$emacsclient -c -a '' -n"
end run
EOF

    osacompile -o "$client_app" "$script"
    rm -f "$script"

    /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string org.gnu.EmacsClient" "$client_app/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :CFBundleName string 'Emacs Client'" "$client_app/Contents/Info.plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Set :CFBundleName 'Emacs Client'" "$client_app/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string 'Emacs Client'" "$client_app/Contents/Info.plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName 'Emacs Client'" "$client_app/Contents/Info.plist" 2>/dev/null || true
}

###############################################################################
# macOS: CLI Entry Point
###############################################################################

# This must be a wrapper script that execs the real, absolute path to the
# binary inside the bundle -- NOT a symlink to it.
#
# Root cause: Emacs.app is a self-contained macOS bundle. To find its own
# Lisp/libexec resources (Contents/Resources/lisp, Contents/MacOS/libexec),
# Emacs checks whether its own invocation path literally contains
# ".../Emacs.app/Contents/MacOS/Emacs" and, if so, strips that suffix to
# get the bundle root. A plain `ln -sf` symlink at $prefix/bin/emacs
# breaks this: the shell invokes the symlink itself (its own path, or just
# the bare command name), which never contains that substring, so the
# bundle-root lookup fails and resource paths resolve to nothing (this is
# exactly the "Contents/MacOS/libexec: No such file" error). `exec`-ing
# the real absolute path from a wrapper script is the standard fix used
# by every CLI shim for a macOS .app (Homebrew casks, VS Code's `code`,
# emacs-plus itself) -- it's not a workaround, it's how self-contained
# bundles are meant to be invoked from the command line.
create_emacs_bin_proxy() {
    local app_dir="$1"
    local bin_file="$2"

    log "Creating emacs wrapper -> $app_dir"
    mkdir -p "$(dirname "$bin_file")"

    cat > "$bin_file" <<EOF
#!/usr/bin/env bash
exec "$app_dir/Contents/MacOS/Emacs" "\$@"
EOF

    chmod +x "$bin_file"
}

###############################################################################
# macOS: LaunchAgent Daemon
###############################################################################

setup_launchagent() {
    log "Configuring macOS LaunchAgent daemon"
    mkdir -p "$(dirname "$PLIST_FILE")"

    local brew_prefix
    brew_prefix="$(brew --prefix)" 2>/dev/null || brew_prefix="/opt/homebrew"

    local gcc_version
    gcc_version="$(brew info --json=v2 gcc | jq -r '.formulae[0].installed[0].version // empty' | head -n 1)" 2>/dev/null || true
    local gcc_major="${gcc_version%%.*}"
    local gcc_lib="$brew_prefix/lib/gcc/$gcc_major"
    local libgccjit_prefix="$brew_prefix/opt/libgccjit"

    local gcc_current="$brew_prefix/opt/gcc/lib/gcc/current"
    local emutls_dir=""
    if [[ -d "$gcc_current/gcc" ]]; then
        emutls_dir="$(find "$gcc_current/gcc" -type f -name "libemutls_w.a" -exec dirname {} \; | head -n 1)"
    fi

    local daemon_library_path="$gcc_lib:$libgccjit_prefix/lib/gcc/current:$brew_prefix/lib"
    [[ -n "$emutls_dir" ]] && daemon_library_path="$emutls_dir:$daemon_library_path"
    local daemon_path="$brew_prefix/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

    cat <<EOF > "$PLIST_FILE"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$PLIST_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$APPS_DIR/Emacs.app/Contents/MacOS/Emacs</string>
        <string>--fg-daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LIBRARY_PATH</key>
        <string>$daemon_library_path</string>
        <key>PATH</key>
        <string>$daemon_path</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
EOF

    local uid="$(id -u)"
    launchctl bootout "gui/$uid" "$PLIST_FILE" 2>/dev/null || true
    launchctl bootstrap "gui/$uid" "$PLIST_FILE"
    echo "✅ LaunchAgent loaded ($PLIST_LABEL)"
}

###############################################################################
# macOS: Code Signing (Deep Pass Fix)
###############################################################################

sign_bundle_macos() {
    local app_path="$1"

    log "Preparing application bundle for code signing: $app_path"

    # 1. Take ownership and strip file locks/read-only attributes first
    chmod -R u+w "$app_path" 2>/dev/null || true
    chflags -R nouchg "$app_path" 2>/dev/null || true

    # 2. Clear extended attributes using standard xattr safely (ignore non-permitted items)
    xattr -rc "$app_path" 2>/dev/null || true

    # 3. Pre-sign non-Mach-O pdmp artifacts
    local pdmp_file="$app_path/Contents/MacOS/libexec/Emacs.pdmp"
    if [[ -f "$pdmp_file" ]]; then
        log "Pre-signing portable dump artifact ($pdmp_file)"
        codesign --force --sign - "$pdmp_file" 2>/dev/null || true
    fi

    # 4. Sign inner compiled native-lisp (.eln) libraries and Mach-O binaries
    log "Signing nested binaries, libraries, and .eln files..."
    find "$app_path" -type f \( -perm +111 -o -name "*.dylib" -o -name "*.so" -o -name "*.eln" \) | while read -r bin; do
        codesign --force --sign - "$bin" 2>/dev/null || true
    done

    # 5. Re-sign the entire top-level bundle structure
    log "Re-signing full bundle structure with deep validation"
    codesign --force --deep --sign - "$app_path"
}

###############################################################################
# macOS: Configure & Build Pipeline
###############################################################################

configure_macos() {
    cd "$SRC_DIR"
    log "Running autogen.sh"
    ./autogen.sh

    log "Configuring Emacs"
    ./configure \
        --prefix="$INSTALL_PREFIX" \
        --with-native-compilation=aot \
        --with-ns \
        --disable-ns-self-contained \
        --with-modules \
        --with-xml2 \
        --with-gnutls \
        --with-rsvg \
        --with-webp \
        --with-tree-sitter \
        --without-compress-install
}

build_macos() {
    require_command brew; require_command gmake; require_command autoconf
    require_command jq; require_command osacompile; require_command codesign

    validate_source_tree

    [[ "$FLAG_PULL" == true ]]        && sync_git_repo
    [[ "$FLAG_CLEAN_BUILD" == true ]] && clean_build_tree

    log "Installing build dependencies"
    brew install "${brew_build_dependencies[@]}"

    local brew_prefix="$(brew --prefix)"
    local sqlite_prefix="$(brew --prefix sqlite)"
    local gcc_prefix="$(brew --prefix gcc)"
    local libgccjit_prefix="$(brew --prefix libgccjit)"

    local gcc_version="$(brew info --json=v2 gcc | jq -r '.formulae[0].installed[0].version // empty' | head -n 1)"
    local gcc_major="${gcc_version%%.*}"
    local gcc_lib="$brew_prefix/lib/gcc/$gcc_major"

    # Locate libemutls_w.a dynamically for native-compilation TLS support
    local gcc_current="$brew_prefix/opt/gcc/lib/gcc/current"
    local emutls_dir=""
    if [[ -d "$gcc_current/gcc" ]]; then
        emutls_dir="$(find "$gcc_current/gcc" -type f -name "libemutls_w.a" -exec dirname {} \; | head -n 1)"
    fi

    export PATH="$brew_prefix/opt/make/libexec/gnubin:$brew_prefix/bin:$PATH"
    export CFLAGS="-DFD_SETSIZE=10000 -DDARWIN_UNLIMITED_SELECT -I$sqlite_prefix/include -I$gcc_prefix/include -I$libgccjit_prefix/include"
    export LDFLAGS="-L$sqlite_prefix/lib -L$gcc_lib -Wl,-rpath,$gcc_lib"
    [[ -n "$emutls_dir" ]] && export LDFLAGS="$LDFLAGS -L$emutls_dir"
    export LIBRARY_PATH="$gcc_lib:$libgccjit_prefix/lib/gcc/current:$brew_prefix/lib"
    [[ -n "$emutls_dir" ]] && export LIBRARY_PATH="$emutls_dir:$LIBRARY_PATH"

    if [[ "$FLAG_NO_RECONFIGURE" == false ]]; then
        configure_macos
    fi

    cd "$SRC_DIR"
    log "Building Emacs"
    gmake -j"$(sysctl -n hw.ncpu)"

    log "Installing Emacs"
    gmake install

    local built_app="$SRC_DIR/nextstep/Emacs.app"
    local installed_app="$APPS_DIR/Emacs.app"

    mkdir -p "$APPS_DIR" "$INSTALL_PREFIX/bin"
    rm -rf "$installed_app"
    cp -R "$built_app" "$installed_app"

    # Inject LSEnvironment into Info.plist for app launcher/Finder executions
    if [[ -n "$emutls_dir" ]]; then
        log "Injecting LIBRARY_PATH into Emacs.app Info.plist for libemutls_w.a"
        /usr/libexec/PlistBuddy -c "Add :LSEnvironment dict" "$installed_app/Contents/Info.plist" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Set :LSEnvironment:LIBRARY_PATH '$LIBRARY_PATH'" "$installed_app/Contents/Info.plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Add :LSEnvironment:LIBRARY_PATH string '$LIBRARY_PATH'" "$installed_app/Contents/Info.plist" 2>/dev/null || true
    fi

    apply_png_icon_macos "$installed_app"
    create_emacs_bin_proxy "$installed_app" "$INSTALL_PREFIX/bin/emacs"

    [[ -x "$INSTALL_PREFIX/bin/emacsclient" ]] ||
        warn "emacsclient was not installed at $INSTALL_PREFIX/bin/emacsclient by 'gmake install'"

    create_client_app_macos
    setup_launchagent

    # Perform recursive code-signing on installed apps
    sign_bundle_macos "$installed_app"
    sign_bundle_macos "$APPS_DIR/Emacs Client.app"

    log "macOS build complete"
}

uninstall_macos() {
    log "Stopping daemon service"
    local uid="$(id -u)"
    if [[ -f "$PLIST_FILE" ]]; then
        launchctl bootout "gui/$uid" "$PLIST_FILE" 2>/dev/null || true
        rm -f "$PLIST_FILE"
    fi

    log "Removing macOS Emacs apps and binaries"
    rm -rf "$APPS_DIR/Emacs.app" "$APPS_DIR/Emacs Client.app"
    rm -f "$INSTALL_PREFIX/bin/emacs" "$INSTALL_PREFIX/bin/emacsclient"

    log "Removing unused Homebrew dependencies"
    brew autoremove
}

status_macos() {
    local uid="$(id -u)"
    echo "--- macOS Status ---"
    [[ -d "$APPS_DIR/Emacs.app" ]] && echo "✅ Emacs.app" || echo "❌ Emacs.app"
    [[ -d "$APPS_DIR/Emacs Client.app" ]] && echo "✅ Emacs Client.app" || echo "❌ Emacs Client.app"
    [[ -x "$INSTALL_PREFIX/bin/emacs" ]] && echo "✅ Binary wrapper" || echo "❌ Binary wrapper"
    [[ -x "$INSTALL_PREFIX/bin/emacsclient" ]] && echo "✅ emacsclient" || echo "❌ emacsclient"
    launchctl print "gui/$uid/${PLIST_LABEL}" >/dev/null 2>&1 && echo "✅ Daemon active" || echo "⚪ Daemon inactive"
}

###############################################################################
# Linux: Icon & Configure
###############################################################################

apply_png_icon_linux() {
    local icon_dir="$(dirname "$(dirname "$SRC_DIR")")/resources/icons"
    local png_file=""
    [[ -d "$icon_dir" ]] &&
        png_file="$(find "$icon_dir" -maxdepth 1 -type f -name '*.png' | sort | head -n 1)"
    [[ -n "$png_file" && -f "$png_file" ]] || return 0

    require_command convert
    local local_icons="$HOME/.local/share/icons/hicolor"

    for size in 16 24 32 48 64 128 256 512; do
        mkdir -p "$local_icons/${size}x${size}/apps"
        convert "$png_file" -resize "${size}x${size}" "$local_icons/${size}x${size}/apps/emacs.png"
    done
    command -v gtk-update-icon-cache >/dev/null 2>&1 &&
        gtk-update-icon-cache -f -t "$local_icons" 2>/dev/null || true
}

configure_arch() {
    cd "$SRC_DIR"
    ./autogen.sh

    log "Configuring Emacs (PGTK)"
    ./configure \
        --prefix="/usr/local" \
        --with-pgtk \
        --with-native-compilation=aot \
        --with-tree-sitter \
        --with-modules \
        --with-json \
        --with-gnutls \
        --with-rsvg \
        --with-webp \
        --with-xml2 \
        --with-cairo \
        --with-mailutils \
        --without-compress-install
}

###############################################################################
# Arch Linux: Build / Uninstall / Status
###############################################################################

build_arch() {
    require_command sudo; require_command pacman; require_command make

    validate_source_tree

    [[ "$FLAG_PULL" == true ]]        && sync_git_repo
    [[ "$FLAG_CLEAN_BUILD" == true ]] && clean_build_tree

    log "Installing Arch dependencies"
    sudo pacman -S --needed base-devel "${arch_build_dependencies[@]}"

    # Expose standard and local paths so pkg-config and linker can find leancrypto
    export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/local/lib/pkgconfig:/usr/share/pkgconfig:${PKG_CONFIG_PATH:-}"
    export LDFLAGS="-L/usr/local/lib -L/usr/lib ${LDFLAGS:-}"
    export CFLAGS="-I/usr/local/include -I/usr/include ${CFLAGS:-}"

    if [[ "$FLAG_NO_RECONFIGURE" == false ]]; then
        configure_arch
    fi

    cd "$SRC_DIR"
    make -j"$(nproc)"
    sudo make install
    apply_png_icon_linux

    if systemctl --user list-unit-files | grep -q emacs.service; then
        systemctl --user daemon-reload
        systemctl --user enable --now emacs.service
    fi

    log "Arch Linux build complete"
}

uninstall_arch() {
    log "Stopping systemd service"
    systemctl --user disable --now emacs.service 2>/dev/null || true

    log "Removing Linux binaries & icons"
    sudo rm -f /usr/local/bin/emacs /usr/local/bin/emacsclient
    for size in 16 24 32 48 64 128 256 512; do
        rm -f "$HOME/.local/share/icons/hicolor/${size}x${size}/apps/emacs.png"
    done

    log "Removing unneeded package dependencies"
    sudo pacman -Rs "$(pacman -Qqdt)" 2>/dev/null || true
}

status_arch() {
    echo "--- Arch Linux Status ---"
    [[ -x "/usr/local/bin/emacs" ]] && echo "✅ Installed (/usr/local/bin/emacs)" || echo "❌ Missing binary"
    systemctl --user is-active --quiet emacs.service && echo "✅ Daemon active" || echo "⚪ Daemon inactive"
}

###############################################################################
# Main Execution Strategy
###############################################################################

case "$OPERATION" in
    SYNC)
        if [[ "$OS" == "Darwin" ]]; then
            if [[ "$FLAG_FORCE_SIGN" == true && "$FLAG_SYNC_BUILD" == false ]]; then
                sign_bundle_macos "$APPS_DIR/Emacs.app"
                sign_bundle_macos "$APPS_DIR/Emacs Client.app"
            else
                build_macos
            fi
        elif [[ "$OS" == "Linux" ]]; then
            build_arch
        fi
        ;;
    REMOVE)
        if [[ "$FLAG_REMOVE" == true ]]; then
            if [[ "$OS" == "Darwin" ]]; then
                uninstall_macos
            elif [[ "$OS" == "Linux" ]]; then
                uninstall_arch
            fi
        else
            error "Must provide sub-flag -c with -R to confirm removal (e.g. $(basename "$0") -Rc)"
        fi
        ;;
    QUERY)
        if [[ "$FLAG_STATUS" == true ]]; then
            if [[ "$OS" == "Darwin" ]]; then
                status_macos
            elif [[ "$OS" == "Linux" ]]; then
                status_arch
            fi
        else
            error "Must specify -s with -Q (e.g. $(basename "$0") -Qs)"
        fi
        ;;
esac