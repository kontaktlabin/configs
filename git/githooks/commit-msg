#!/bin/sh

# Runs validation on the final commit message.
# COMMIT_MSG_FILE: path to the message file.
COMMIT_MSG_FILE=$1
CURRENT_COMMIT_MESSAGE=$(cat "$COMMIT_MSG_FILE")

# 1. Conventional Commits Regex Check (Format Validation)
# Format: type - scope: message
# Expanded types: feat, fix, docs, chore, refactor, perf, build, ci, test, revert, clean
# Enforces the 'type - scope: ' structure.
COMMIT_REGEX='^(feat|fix|docs|chore|refactor|perf|build|ci|test|revert|clean) - [a-z0-9-]+: .+$'

if ! echo "$CURRENT_COMMIT_MESSAGE" | grep -qE "$COMMIT_REGEX"; then
    echo ""
    echo "======================================================================================="
    echo "🚨 COMMIT FAILED: Invalid commit message format."
    echo "Please standardize using the specified format."
    echo "Format: <type> - <scope>: <subject>"
    echo ""
    echo "Valid types include: feat, fix, docs, chore, refactor, perf, build, ci, test, revert, clean."
    echo "Example: fix - api: resolve login endpoint error"
    echo "======================================================================================="
    exit 1
fi

# 2. Placeholder Check
# Searches for pattern like ${{text}} anywhere in the message.
if echo "$CURRENT_COMMIT_MESSAGE" | grep -qE '\$\{\{[a-zA-Z0-9]+\}\}'; then
    echo ""
    echo "======================================================================================="
    echo "⚠️ WARNING: Commit message contains unresolved placeholders."
    echo "Please ensure all placeholders (e.g., ${{TODO}}) are removed and the message is finalized."
    echo "======================================================================================="
    exit 1
fi

exit 0
